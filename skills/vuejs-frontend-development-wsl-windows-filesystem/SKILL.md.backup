# Vue.js Frontend Development in WSL with Windows Filesystem

Complete workflow for creating Vue.js projects when working in WSL with Windows filesystem mounted drives (e.g., /mnt/c/, /mnt/d/), addressing common permission and execution issues.

## When to Use This Skill

Use this skill when you need to:
- Create a Vue.js frontend project in WSL
- Work with Windows filesystem paths (mounted under /mnt/)
- Avoid npm permission errors on Windows drives
- Set up Vue.js + Vite + Element Plus projects
- Configure frontend-backend integration with Flask APIs

## Common Issues and Solutions

### Issue 1: npm install Permission Errors
**Problem**: `EPERM: operation not permitted, chmod` errors during npm install on Windows drives

**Solution**: Use `--no-bin-links` flag
```bash
npm install --no-bin-links
```

### Issue 2: Vite Command Not Found
**Problem**: `sh: 1: vite: not found` when running `npm run dev`

**Solution**: Run Vite directly with node
```bash
node node_modules/vite/bin/vite.js
```

### Issue 3: Project Creation Permission Errors
**Problem**: `EPERM: operation not permitted, copyfile` when using `npm create vite@latest`

**Solution**: Create project in /tmp first, then copy
```bash
# Create in tmp
cd /tmp && npm create vite@latest project-name -- --template vue

# Copy to target location
cp -r /tmp/project-name/* /mnt/d/target/path/
cp -r /tmp/project-name/.[!.]* /mnt/d/target/path/ 2>/dev/null || true
```

## Complete Workflow

### Step 1: Environment Check
```bash
# Check Node.js and npm versions
node --version && npm --version
```

### Step 2: Create Vue Project
```bash
# Navigate to temporary directory
cd /tmp

# Create Vue project with Vite
npm create vite@latest project-name -- --template vue

# Copy to target Windows drive location
cp -r /tmp/project-name/* /mnt/d/target/path/
cp -r /tmp/project-name/.[!.]* /mnt/d/target/path/ 2>/dev/null || true
```

### Step 3: Install Dependencies
```bash
cd /mnt/d/target/path/project-name

# Install base dependencies with --no-bin-links
npm install --no-bin-links

# Install additional dependencies
npm install axios vue-router@4 pinia element-plus --no-bin-links
npm install @element-plus/icons-vue --no-bin-links
```

### Step 4: Create Project Structure
```bash
cd src
mkdir -p api components views router stores utils
```

### Step 5: Configure Vite for Backend Integration
```javascript
// vite.config.js
import { defineConfig } from 'vite'
import vue from '@vitejs/plugin-vue'

export default defineConfig({
  plugins: [vue()],
  server: {
    port: 8080,
    host: '0.0.0.0',
    proxy: {
      '/api': {
        target: 'http://127.0.0.1:5000',
        changeOrigin: true,
        rewrite: (path) => path
      }
    }
  }
})
```

### Step 6: Setup Axios with Interceptors
```javascript
// src/utils/request.js
import axios from 'axios'
import { ElMessage } from 'element-plus'

const request = axios.create({
  baseURL: '/api/v1', // Use Vite proxy
  timeout: 10000,
  headers: {
    'Content-Type': 'application/json'
  }
})

// Request interceptor - add token
request.interceptors.request.use(
  config => {
    const token = localStorage.getItem('token')
    if (token) {
      config.headers['Authorization'] = `Bearer ${token}`
    }
    return config
  },
  error => Promise.reject(error)
)

// Response interceptor - handle errors
request.interceptors.response.use(
  response => {
    const res = response.data
    if (res.success === false) {
      ElMessage.error(res.message || '请求失败')
      return Promise.reject(new Error(res.message))
    }
    return res
  },
  error => {
    // Handle different error status codes
    if (error.response) {
      const { status } = error.response
      switch (status) {
        case 401:
          ElMessage.error('未授权，请重新登录')
          localStorage.removeItem('token')
          window.location.href = '/login'
          break
        case 403:
          ElMessage.error('拒绝访问')
          break
        case 404:
          ElMessage.error('请求的资源不存在')
          break
        case 500:
          ElMessage.error('服务器错误')
          break
        default:
          ElMessage.error(`请求失败 (${status})`)
      }
    }
    return Promise.reject(error)
  }
)

export default request
```

### Step 7: Setup Pinia Store for User State
```javascript
// src/stores/user.js
import { defineStore } from 'pinia'
import { login as loginApi, logout as logoutApi } from '@/api/auth'

export const useUserStore = defineStore('user', {
  state: () => ({
    token: localStorage.getItem('token') || '',
    refreshToken: localStorage.getItem('refreshToken') || '',
    userInfo: null,
    roles: []
  }),

  getters: {
    isLoggedIn: (state) => !!state.token,
    isAdmin: (state) => state.roles.includes('admin'),
    username: (state) => state.userInfo?.username || ''
  },

  actions: {
    async login(credentials) {
      const response = await loginApi(credentials)
      if (response.success) {
        this.token = response.data.access_token
        this.refreshToken = response.data.refresh_token
        this.userInfo = response.data.user
        this.roles = response.data.user.roles || []
        
        localStorage.setItem('token', this.token)
        localStorage.setItem('refreshToken', this.refreshToken)
        return { success: true }
      }
      return { success: false, message: response.message }
    },

    async logout() {
      try {
        await logoutApi()
      } catch (error) {
        console.error('登出API调用失败:', error)
      } finally {
        this.token = ''
        this.refreshToken = ''
        this.userInfo = null
        this.roles = []
        localStorage.removeItem('token')
        localStorage.removeItem('refreshToken')
      }
    }
  }
})
```

### Step 8: Setup Vue Router with Guards
```javascript
// src/router/index.js
import { createRouter, createWebHistory } from 'vue-router'
import { useUserStore } from '@/stores/user'

const routes = [
  {
    path: '/login',
    name: 'Login',
    component: () => import('@/views/Login.vue'),
    meta: { title: '登录', requiresAuth: false }
  },
  {
    path: '/',
    name: 'Home',
    component: () => import('@/views/Home.vue'),
    meta: { title: '首页', requiresAuth: true }
  },
  // Add more routes...
]

const router = createRouter({
  history: createWebHistory(),
  routes
})

// Route guard
router.beforeEach((to, from, next) => {
  const userStore = useUserStore()
  
  document.title = to.meta.title ? `${to.meta.title} - 应用名称` : '应用名称'
  
  if (to.meta.requiresAuth && !userStore.isLoggedIn) {
    next({
      path: '/login',
      query: { redirect: to.fullPath }
    })
  } else if (to.meta.requiresAdmin && !userStore.isAdmin) {
    next({ path: '/' })
  } else {
    next()
  }
})

export default router
```

### Step 9: Configure Main Entry Point
```javascript
// src/main.js
import { createApp } from 'vue'
import { createPinia } from 'pinia'
import ElementPlus from 'element-plus'
import 'element-plus/dist/index.css'
import * as ElementPlusIconsVue from '@element-plus/icons-vue'
import App from './App.vue'
import router from './router'

const app = createApp(App)
const pinia = createPinia()

app.use(ElementPlus)

// Register all Element Plus icons
for (const [key, component] of Object.entries(ElementPlusIconsVue)) {
  app.component(key, component)
}

app.use(router)
app.use(pinia)
app.mount('#app')
```

### Step 10: Start Development Servers
```bash
# Start backend (Flask)
cd /path/to/backend
python3 run.py &

# Start frontend (Vue)
cd /path/to/frontend
node node_modules/vite/bin/vite.js &
```

## Testing Checklist

- [ ] Backend API accessible at http://127.0.0.1:5000
- [ ] Frontend accessible at http://127.0.0.1:8080
- [ ] Login functionality works
- [ ] API calls successful (check browser console)
- [ ] Token stored in localStorage
- [ ] Route guards working
- [ ] Proxy configuration correct

